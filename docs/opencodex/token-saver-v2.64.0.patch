+import { expect, test, spyOn } from "bun:test";
+import * as http from "node:http";
+import { mkdtempSync, writeFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { handleResponses } from "../../src/server/responses";
+import type { OcxConfig } from "../../src/types";
+import { acquireOwnedSpendHome } from "../helpers/owned-spend-home";
+import { removeTreeWithRetry } from "../helpers/remove-tree";
+import { startServer } from "../../src/server";
+import { saveConfig } from "../../src/config";
+import { readTokenSaverControl, setTokenSaverControl } from "../../src/config/token-saver-control";
+import { ownedServiceHomeInspection } from "../helpers/owned-service-home-inspection";
+
+const service = process.env.CTS_TRANSFORM_TEST_URL;
+const pipelineTest = service ? test : test.skip;
+pipelineTest("real server HTTP, WebSocket delta, reconnect and concurrent chats preserve provider requests", async () => {
+  const directory = mkdtempSync(join(tmpdir(), "cts-sockets-"));
+  const oldHome = process.env.OPENCODEX_HOME, oldCodex = process.env.CODEX_HOME;
+  process.env.OPENCODEX_HOME = join(directory, "ocx");
+  process.env.CODEX_HOME = join(directory, "codex");
+  mkdirSync(process.env.CODEX_HOME, { recursive: true });
+  const tokenFile = join(directory, "token");
+  writeFileSync(tokenFile, "a".repeat(64));
+  const bodies: any[] = [];
+  const upstream = Bun.serve({ port: 0, hostname: "127.0.0.1", async fetch(req) {
+    if (!new URL(req.url).pathname.endsWith("/responses")) return Response.json({ data: [] });
+    bodies.push(await req.json());
+    const id = "resp_cts_" + bodies.length;
+    return new Response("event: response.completed\ndata: " + JSON.stringify({
+      type: "response.completed", response: { id, status: "completed", output: [
+        { type: "function_call", id: "fc_next", call_id: "next_call", name: "exec", arguments: "{}", status: "completed" },
+      ] },
+    }) + "\n\n", { headers: { "content-type": "text/event-stream" } });
+  } });
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = ((input: any, init: any) => {
+    const url = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url);
+    if (url.hostname !== "127.0.0.1" && url.hostname !== "localhost") throw new Error("Only isolated loopback traffic is permitted");
+    return originalFetch(input, init);
+  }) as typeof fetch;
+  const request = http.request;
+  const local = spyOn(http, "request").mockImplementation(((options: any, callback: any) => {
+    expect(options.host).toBe("127.0.0.1"); expect(options.port).toBe(8789);
+    return request({ ...options, port: Number(new URL(service!).port) }, callback);
+  }) as typeof http.request);
+  let server: ReturnType<typeof startServer> | undefined;
+  const sockets: WebSocket[] = [];
+  const original = "socket original output 中🙂\n".repeat(180);
+  const input = (text: string) => [
+    { type: "function_call", call_id: "first_call", name: "exec", arguments: "{}" },
+    { type: "function_call_output", call_id: "first_call", output: text },
+  ];
+  const payload = (text: string) => ({ model: "fixture/gpt-5.6-sol", stream: true, reasoning: { effort: "high" }, input: input(text) });
+  const terminal = (ws: WebSocket) => new Promise<any>((resolve, reject) => {
+    const done = (event: MessageEvent) => {
+      const value = JSON.parse(String(event.data));
+      if (value.type === "error" || value.type === "response.failed") { cleanup(); reject(new Error(JSON.stringify(value))); }
+      else if (value.type === "response.completed") { cleanup(); resolve(value); }
+    };
+    const timer = setTimeout(() => { cleanup(); reject(new Error("Socket terminal timeout")); }, 10_000);
+    function cleanup() { clearTimeout(timer); ws.removeEventListener("message", done); }
+    ws.addEventListener("message", done);
+  });
+  const connect = async () => {
+    const url = new URL("/v1/responses", server!.url); url.protocol = "ws:";
+    const ws = new WebSocket(url, { headers: { authorization: "Bearer fixture-caller" } } as unknown as string[]);
+    sockets.push(ws);
+    await new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => reject(new Error("Socket open timeout")), 5_000);
+      ws.addEventListener("open", () => { clearTimeout(timer); resolve(); }, { once: true });
+      ws.addEventListener("error", () => { clearTimeout(timer); reject(new Error("Socket open failed")); }, { once: true });
+    });
+    return ws;
+  };
+  try {
+    saveConfig({ port: 0, defaultProvider: "fixture", websockets: true,
+      tokenSaver: { enabled: true, protocol: 1, endpoint: "http://127.0.0.1:8789", tokenFile },
+      providers: { fixture: { adapter: "openai-responses", authMode: "api-key", apiKey: "fixture",
+        baseUrl: upstream.url.origin + "/v1", allowPrivateNetwork: true, upstreamWebsocket: false } },
+    } as OcxConfig);
+    server = startServer(0, { inspectNativeCodexOwnership: ownedServiceHomeInspection("Token Saver socket fixture") });
+    const ready: any = await (await fetch(new URL("/readyz", server.url))).json();
+    expect(ready.tokenSaver).toEqual({ protocol: 1, control: 1, enabled: true });
+    const response = await fetch(new URL("/v1/responses", server.url), { method: "POST",
+      headers: { "content-type": "application/json", authorization: "Bearer fixture-caller" }, body: JSON.stringify(payload(original)) });
+    expect(response.status).toBe(200); expect(await response.text()).toContain("response.completed");
+    const ws = await connect();
+    const first = terminal(ws); ws.send(JSON.stringify({ type: "response.create", ...payload(original) }));
+    const completed = await first;
+    const delta = terminal(ws); ws.send(JSON.stringify({ type: "response.create", model: "fixture/gpt-5.6-sol",
+      reasoning: { effort: "high" }, previous_response_id: completed.response.id,
+      input: [{ type: "function_call_output", call_id: "next_call", output: original + "delta" }] }));
+    await delta;
+    ws.close();
+    const reconnected = await connect();
+    const replay = terminal(reconnected); reconnected.send(JSON.stringify({ type: "response.create", ...payload(original + "reconnect") }));
+    await replay;
+    await Promise.all(["chat-a", "chat-b"].map(async chat => {
+      const client = await connect(), done = terminal(client);
+      client.send(JSON.stringify({ type: "response.create", ...payload(original + chat) }));
+      await done;
+    }));
+    expect(bodies).toHaveLength(6);
+    for (const body of bodies) {
+      expect(body.model).toBe("gpt-5.6-sol"); expect(body.reasoning.effort).toBe("high");
+      expect(body.input.filter((item: any) => item.type === "function_call_output").at(-1).output).toContain("Headroom request overview v1");
+    }
+    expect(bodies[2].input.some((item: any) => item.call_id === "next_call")).toBe(true);
+    expect(input(original)[1]!.output).toBe(original);
+    const current = readTokenSaverControl();
+    const paused = setTokenSaverControl(current.fingerprint, { ...current.value!, enabled: false });
+    const pausedReady: any = await (await fetch(new URL("/readyz", server.url))).json();
+    expect(pausedReady.tokenSaver.enabled).toBe(false);
+    const unchanged = terminal(reconnected);
+    reconnected.send(JSON.stringify({ type: "response.create", ...payload(original + "paused") }));
+    await unchanged;
+    expect(bodies.at(-1).input.filter((item: any) => item.type === "function_call_output").at(-1).output).toBe(original + "paused");
+    setTokenSaverControl(paused.fingerprint, current.value);
+    const resumed = terminal(reconnected);
+    reconnected.send(JSON.stringify({ type: "response.create", ...payload(original + "resumed") }));
+    await resumed;
+    expect(bodies.at(-1).input.filter((item: any) => item.type === "function_call_output").at(-1).output).toContain("Headroom request overview v1");
+    expect(bodies).toHaveLength(8);
+  } finally {
+    for (const socket of sockets) socket.close();
+    await server?.stop(true); await upstream.stop(true);
+    local.mockRestore(); globalThis.fetch = originalFetch;
+    if (oldHome === undefined) delete process.env.OPENCODEX_HOME; else process.env.OPENCODEX_HOME = oldHome;
+    if (oldCodex === undefined) delete process.env.CODEX_HOME; else process.env.CODEX_HOME = oldCodex;
+    removeTreeWithRetry(directory);
+  }
+}, 45_000);
+
+pipelineTest("HTTP and WS-prepared core dispatch use the transformer, including native forwarding", async () => {
+  expect(service).toMatch(/^http:\/\/127\.0\.0\.1:\d+$/);
+  const directory = mkdtempSync(join(tmpdir(), "cts-pipeline-"));
+  const oldHome = process.env.OPENCODEX_HOME;
+  process.env.OPENCODEX_HOME = join(directory, "ocx");
+  const tokenFile = join(directory, "token");
+  writeFileSync(tokenFile, "a".repeat(64));
+  const release = acquireOwnedSpendHome();
+  const request = http.request;
+  // Only remap the test service's TCP port; exercise production token I/O and HTTP framing.
+  const local = spyOn(http, "request").mockImplementation(((options: any, callback: any) => {
+    expect(options.host).toBe("127.0.0.1"); expect(options.port).toBe(8789);
+    return request({ ...options, port: Number(new URL(service!).port) }, callback);
+  }) as typeof http.request);
+  const realFetch = globalThis.fetch;
+  const bodies: any[] = [];
+  globalThis.fetch = (async (_url: any, init: any) => {
+    bodies.push(JSON.parse(init.body));
+    return new Response('data: {"type":"response.completed","response":{"id":"resp_fixture","status":"completed","output":[{"type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"ok"}]}]}}\n\n',
+      { headers: { "content-type": "text/event-stream" } });
+  }) as typeof fetch;
+  try {
+    for (const [authMode, inboundTransport] of [
+      ["api-key", "http"], ["forward", "http"], ["forward", "websocket"],
+    ] as const) {
+      const providerName = authMode === "forward" ? "openai" : "fixture";
+      const config = { port: 0, defaultProvider: providerName,
+        tokenSaver: { enabled: true, protocol: 1, endpoint: "http://127.0.0.1:8789", tokenFile },
+        providers: { [providerName]: { adapter: "openai-responses", authMode, apiKey: "fixture",
+          baseUrl: authMode === "forward" ? "https://chatgpt.com/backend-api/codex" : "https://provider.invalid/v1",
+          ...(authMode === "forward" ? { codexAccountMode: "direct" } : {}), upstreamWebsocket: false } },
+      } as OcxConfig;
+      saveConfig(config);
+      expect(readTokenSaverControl().value).toEqual(config.tokenSaver);
+      const original = "pipeline original diagnostic output line 中🙂\n".repeat(90);
+      const response = await handleResponses(new Request("http://localhost/v1/responses", {
+        method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer fixture-token" },
+        body: JSON.stringify({ model: providerName + "/gpt-5.6-sol", stream: true, reasoning: { effort: "high" }, input: [
+          { type: "function_call", call_id: "c1", name: "exec", arguments: "{}" },
+          { type: "function_call_output", call_id: "c1", output: original },
+        ] }),
+      }), config, { model: "", provider: "" }, { inboundTransport });
+      expect(response.status).toBe(200);
+      expect(await response.text()).toContain("response.completed");
+      const observed = bodies.at(-1);
+      expect(observed.input.find((i: any) => i.type === "function_call_output").output).toContain("Headroom request overview v1");
+      expect(observed.reasoning.effort).toBe("high");
+      expect(observed.model).toBe("gpt-5.6-sol");
+    }
+    expect(bodies).toHaveLength(3); expect(local).toHaveBeenCalledTimes(3);
+  } finally {
+    globalThis.fetch = realFetch; local.mockRestore(); release();
+    if (oldHome === undefined) delete process.env.OPENCODEX_HOME; else process.env.OPENCODEX_HOME = oldHome;
+    removeTreeWithRetry(directory);
