+import { expect, test } from "bun:test";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { repoPath } from "../helpers/repo-root";
+import { removeTreeWithRetry } from "../helpers/remove-tree";
+import { validateReadyzBody } from "../../src/server/proxy-liveness";
+import { runReady } from "../../src/cli/ready";
+
+test("ready publishes only validated capability fields from the serving process", async () => {
+  const metadata = { protocol: 1, control: 1, enabled: false };
+  const body = { service: "opencodex", version: "fixture", uptime: 1, pid: 123, port: 10100, status: "ready",
+    tokenSaver: { ...metadata, secret: "must-not-escape" } };
+  const probe = validateReadyzBody(body, 10100, { expectedPid: 123 })!;
+  expect((probe as any).tokenSaver).toEqual(metadata);
+  const lines: string[] = [];
+  expect(await runReady({ json: true, wait: false, timeoutSeconds: 45 }, {
+    findLive: async () => ({ pid: 123, port: 10100 }), probe: async () => probe,
+    stdout: { log: s => lines.push(s) },
+  })).toBe(0);
+  expect(JSON.parse(lines[0]!).tokenSaver).toEqual(metadata);
+  expect(lines.join("")).not.toContain("must-not-escape");
+  expect((validateReadyzBody({ ...body, tokenSaver: { ...metadata, protocol: 9 } }, 10100) as any).tokenSaver).toBeUndefined();
+  expect(validateReadyzBody(body, 10100, { expectedPid: 999 })).toBeNull();
+});
+
+test("conditional extension writes preserve providers and Codex bytes; stale writes fail", () => {
+  const dir = mkdtempSync(join(tmpdir(), "cts-control-"));
+  const initial = { port: 10100, defaultProvider: "fixture", providers: {
+    fixture: { adapter: "openai-chat", baseUrl: "https://provider.invalid/v1", authMode: "api-key", apiKey: "fixture-private-key" },
+  } };
+  const configPath = join(dir, "config.json"), codexPath = join(dir, "config.toml");
+  writeFileSync(configPath, JSON.stringify(initial));
+  const codex = '# keep comment\nmodel = "chosen"\nmodel_reasoning_effort = "high"\n';
+  writeFileSync(codexPath, codex);
+  const binary = process.env.CTS_TEST_OCX_BINARY;
+  const run = (args: string[]) => spawnSync(binary || process.execPath, [...(binary ? [] : [repoPath("src", "cli", "index.ts")]), "config", ...args, "--json"], {
+    cwd: repoPath(), env: { ...process.env, OPENCODEX_HOME: dir, CODEX_HOME: dir }, encoding: "utf8", timeout: 20_000,
+  });
+  try {
+    const before = run(["token-saver-state"]);
+    expect(before.status).toBe(0);
+    const empty = JSON.parse(before.stdout); expect(empty.value).toBeNull();
+    const value = { protocol: 1, enabled: true, endpoint: "http://127.0.0.1:8789", tokenFile: join(dir, "token 中.txt") };
+    const enabled = run(["token-saver-set", empty.fingerprint, JSON.stringify(value)]);
+    expect(enabled.status).toBe(0); expect(JSON.parse(enabled.stdout).value).toEqual(value);
+    const stale = run(["token-saver-set", empty.fingerprint, "null"]);
+    expect(stale.status).not.toBe(0);
+    expect(JSON.parse(readFileSync(configPath, "utf8")).tokenSaver).toEqual(value);
+    expect(enabled.stdout + enabled.stderr + stale.stdout + stale.stderr).not.toContain("fixture-private-key");
+    const current = JSON.parse(enabled.stdout);
+    expect(run(["token-saver-set", current.fingerprint, JSON.stringify({ ...value, endpoint: "https://elsewhere.invalid" })]).status).not.toBe(0);
+    const removed = run(["token-saver-set", current.fingerprint, "null"]);
+    expect(removed.status).toBe(0);
+    expect(JSON.parse(readFileSync(configPath, "utf8")).tokenSaver).toBeUndefined();
+    expect(JSON.parse(readFileSync(configPath, "utf8")).providers.fixture.apiKey).toBe("fixture-private-key");
+    expect(readFileSync(codexPath, "utf8")).toBe(codex);
+  } finally { removeTreeWithRetry(dir); }
+}, 120_000);
