diff --git a/src/integrations/token-saver.ts b/src/integrations/token-saver.ts
new file mode 100644
index 0000000..1c56878
--- /dev/null
+++ b/src/integrations/token-saver.ts
@@ -0,0 +1,169 @@
+import { createHash, randomUUID } from "node:crypto";
+import { open } from "node:fs/promises";
+import { isAbsolute } from "node:path";
+import { request as httpRequest } from "node:http";
+import type { OcxParsedRequest } from "../types";
+
+export interface TokenSaverConfig {
+  enabled: boolean;
+  endpoint: string;
+  tokenFile: string;
+  protocol: 1;
+}
+const LIMIT = 8 * 1024 * 1024;
+const hash = (s: string) => createHash("sha256").update(s).digest("hex");
+type Entry = { id: string; original_sha256: string; text: string };
+type Replacement = { id: string; original_sha256: string; replacement: string; retrieval_reference: string };
+type Io = {
+  now?: () => number;
+  readToken?: (path: string) => Promise<string>;
+  localFetch?: (url: string, init: RequestInit) => Promise<Response>;
+};
+
+async function untilAborted<T>(work: Promise<T>, signal: AbortSignal, fallback: T): Promise<T> {
+  let onAbort: () => void = () => {};
+  const expired = new Promise<T>(resolve => {
+    onAbort = () => resolve(fallback);
+    if (signal.aborted) onAbort();
+    else signal.addEventListener("abort", onAbort, { once: true });
+  });
+  try { return await Promise.race([work, expired]); }
+  finally { signal.removeEventListener("abort", onAbort); }
+}
+
+async function readToken(path: string): Promise<string> {
+  if (!isAbsolute(path)) throw new Error("Token path must be absolute");
+  const file = await open(path, "r");
+  try {
+    const bytes = Buffer.alloc(65);
+    const { bytesRead } = await file.read(bytes, 0, 65, 0);
+    const token = bytes.subarray(0, bytesRead).toString("ascii");
+    if (!/^[a-f0-9]{64}$/.test(token)) throw new Error("Invalid local token");
+    return token;
+  } finally { await file.close(); }
+}
+
+/** Fixed loopback destination; node:http neither reads proxy env nor follows redirects. */
+function localPost(_url: string, init: RequestInit): Promise<Response> {
+  return new Promise((resolve, reject) => {
+    const body = String(init.body);
+    const req = httpRequest({
+      host: "127.0.0.1", port: 8789, path: "/v1/transform/tool-results", method: "POST",
+      headers: { ...Object.fromEntries(new Headers(init.headers)), "Content-Length": Buffer.byteLength(body) },
+      signal: init.signal ?? undefined, agent: false,
+    }, res => {
+      const chunks: Buffer[] = []; let size = 0;
+      res.on("data", (chunk: Buffer) => {
+        size += chunk.length;
+        if (size > LIMIT) { res.destroy(); req.destroy(new Error("Oversized reply")); return; }
+        chunks.push(chunk);
+      });
+      res.on("error", reject);
+      res.on("end", () => resolve(new Response(Buffer.concat(chunks), { status: res.statusCode ?? 500 })));
+    });
+    req.on("error", reject);
+    req.end(body);
+  });
+}
+
+function select(parsed: OcxParsedRequest) {
+  const entries: Entry[] = [];
+  const positions = new Map<string, { message: number; raw?: number }>();
+  const body = parsed._rawBody as { input?: unknown } | undefined;
+  const input = body && Array.isArray(body.input) ? body.input as Record<string, unknown>[] : undefined;
+  for (const [index, message] of parsed.context.messages.entries()) {
+    if (message.role !== "toolResult" || message.containsEncryptedContent || typeof message.content !== "string") continue;
+    const text = message.content;
+    if (Buffer.byteLength(text) < 1024 || text.trimStart().startsWith("{") || text.trimStart().startsWith("[") || text.includes("<<ccr:")) continue;
+    let raw: number | undefined;
+    if (body) {
+      if (!input) continue;
+      const matches = input.flatMap((item, i) => item && item.type === "function_call_output"
+        && item.call_id === message.toolCallId && item.output === text ? [i] : []);
+      if (matches.length !== 1) continue;
+      raw = matches[0];
+    }
+    const id = `m${index}`;
+    entries.push({ id, original_sha256: hash(text), text });
+    positions.set(id, { message: index, raw });
+    if (entries.length > 128) return null;
+  }
+  return { entries, positions, input };
+}
+
+function validate(value: any, requestId: string, entries: Entry[]): Replacement[] {
+  if (!value || value.protocol !== 1 || value.request_id !== requestId || !Array.isArray(value.replacements)
+      || !["compressed", "unchanged", "bypassed", "error"].includes(value.outcome)
+      || Object.keys(value).some(k => !["protocol", "request_id", "outcome", "replacements", "reason"].includes(k))) throw new Error("Invalid reply");
+  if (value.outcome !== "compressed") {
+    if (value.replacements.length) throw new Error("Unexpected replacements");
+    return [];
+  }
+  const seen = new Set<string>();
+  for (const r of value.replacements) {
+    const entry = r && entries.find(e => e.id === r.id);
+    if (!entry || seen.has(r.id) || Object.keys(r).sort().join(",") !== "id,original_sha256,replacement,retrieval_reference"
+        || r.original_sha256 !== entry.original_sha256 || r.retrieval_reference !== entry.original_sha256.slice(0, 12)
+        || typeof r.replacement !== "string" || Buffer.byteLength(r.replacement) >= Buffer.byteLength(entry.text)
+        || !r.replacement.startsWith(`[Headroom request overview v1; exact original: headroom_retrieve(content_hash="${r.retrieval_reference}")]\n`)
+        || r.replacement.includes("<<ccr:")) throw new Error("Invalid replacement");
+    seen.add(r.id);
+  }
+  return value.replacements;
+}
+
+/** One decision per content version, shared by adapters/rebuilds within one logical request. */
+export function createTokenSaverTransform(config: TokenSaverConfig | undefined, scope: string, signal: AbortSignal, io: Io = {}) {
+  const decisions = new Map<string, Promise<Replacement[]>>();
+  const created = new Map<string, number>();
+  const now = io.now ?? Date.now;
+  let cachedBytes = 0;
+  return async (parsed: OcxParsedRequest): Promise<OcxParsedRequest> => {
+    if (!config?.enabled || config.protocol !== 1 || config.endpoint !== "http://127.0.0.1:8789"
+        || signal.aborted || parsed._compactionRequest || parsed._portableCompaction) return parsed;
+    const selected = select(parsed);
+    if (!selected?.entries.length) return parsed;
+    const { entries, positions, input } = selected;
+    const key = hash(JSON.stringify(entries.map(e => [e.id, e.original_sha256])));
+    let decision = decisions.get(key);
+    // Refuse reuse before the service's 30-minute original retention expires.
+    if (decision && now() - created.get(key)! >= 25 * 60_000) return parsed;
+    if (!decision) {
+      // Bounds all versions retained by a long-running sidecar loop; bypass after the limit.
+      const requestId = randomUUID();
+      const body = JSON.stringify({ protocol: 1, request_id: requestId, scope_id: hash(scope), budget_ms: 450, entries });
+      if (Buffer.byteLength(body) > LIMIT || decisions.size >= 8 || cachedBytes + Buffer.byteLength(body) > 32 * 1024 * 1024) return parsed;
+      cachedBytes += Buffer.byteLength(body);
+      decision = (async () => {
+        const deadline = AbortSignal.any([signal, AbortSignal.timeout(500)]);
+        try {
+          const token = await untilAborted((io.readToken ?? readToken)(config.tokenFile), deadline, "");
+          if (deadline.aborted || !/^[a-f0-9]{64}$/.test(token)) return [];
+          const response = await untilAborted<Response | null>((io.localFetch ?? localPost)(config.endpoint + "/v1/transform/tool-results", {
+            method: "POST", body, signal: deadline,
+            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
+          }), deadline, null);
+          if (!response?.ok || deadline.aborted) return [];
+          const bytes = await untilAborted(response.text(), deadline, "");
+          if (Buffer.byteLength(bytes) > LIMIT || deadline.aborted) return [];
+          return validate(JSON.parse(bytes), requestId, entries);
+        } catch { return []; }
+      })();
+      decisions.set(key, decision);
+      created.set(key, now());
+    }
+    const replacements = await decision;
+    if (signal.aborted || !replacements.length) return parsed;
+    const messages = [...parsed.context.messages];
+    const rawInput = input ? [...input] : undefined;
+    for (const replacement of replacements) {
+      const position = positions.get(replacement.id)!;
+      const original = messages[position.message]!;
+      if (original.role !== "toolResult") return parsed;
+      messages[position.message] = { ...original, content: replacement.replacement };
+      if (rawInput && position.raw !== undefined) rawInput[position.raw] = { ...rawInput[position.raw], output: replacement.replacement };
+    }
+    return { ...parsed, context: { ...parsed.context, messages },
+      ...(rawInput ? { _rawBody: { ...(parsed._rawBody as object), input: rawInput } } : {}) };
+  };
+}
