+import { createOpenAIChatAdapter } from "../../src/adapters/openai-chat";
+import { parseRequest } from "../../src/responses/parser";
+import { withTestTranslatorBudget } from "../helpers/translator-budget";
+
+// Run only through the bundle witness, which starts the real service on an isolated port.
+const service = process.env.CTS_TRANSFORM_TEST_URL;
+const wireTest = service ? test : test.skip;
+wireTest("real service transforms hydrated copies for Responses and Chat without extra provider sends", async () => {
+  expect(service).toMatch(/^http:\/\/127\.0\.0\.1:\d+$/);
+  const original = "Unicode 中🙂 exact worker detail 123456789\n".repeat(90);
+  const raw = { model: "chosen", reasoning: { effort: "high" }, stream: false, input: [
+    { role: "user", content: "Inspect the tool output" },
+    { type: "function_call", call_id: "c1", name: "exec", arguments: "{}" },
+    { type: "function_call_output", call_id: "c1", output: original },
+  ] };
+  const input = parseRequest(raw);
+  const before = structuredClone(input);
+  let transforms = 0, sends = 0;
+  const provider = Bun.serve({
+    hostname: "127.0.0.1", port: 0,
+    async fetch(req) {
+      sends++; return Response.json({ observed: await req.json() });
+    },
+  });
+  try {
+    const config = { enabled: true, protocol: 1 as const, endpoint: "http://127.0.0.1:8789", tokenFile: "fixture" };
+    const transform = createTokenSaverTransform(config, "wire-fixture", new AbortController().signal, {
+      readToken: async () => "a".repeat(64),
+      localFetch: async (_url, init) => {
+        transforms++;
+        return fetch(service + "/v1/transform/tool-results", { ...init, proxy: "" });
+      },
+    });
+    const transformed = await transform(input);
+    expect(transformed).not.toBe(input);
+    expect(input).toEqual(before);
+    expect(transformed.options).toBe(input.options);
+    expect(transformed.modelId).toBe(input.modelId);
+    const tool = transformed.context.messages.find(m => m.role === "toolResult")!;
+    expect(tool.content).toContain("Headroom request overview v1");
+    const ref = String(tool.content).match(/content_hash="([a-f0-9]{12})"/)![1];
+    const exact = await fetch(service + "/v1/retrieve/" + ref, { proxy: "", headers: { Authorization: "Bearer " + "a".repeat(64) } });
+    const recovered = await exact.json() as any;
+    expect(recovered.original_content).toBe(original);
+    for (const kind of ["responses", "chat"] as const) {
+      const providerConfig = { adapter: kind === "responses" ? "openai-responses" : "openai-chat",
+        baseUrl: `http://127.0.0.1:${provider.port}/v1`, authMode: "api-key" as const, apiKey: "fixture" };
+      const adapter = withTestTranslatorBudget(kind === "responses"
+        ? createResponsesPassthroughAdapter(providerConfig) : createOpenAIChatAdapter(providerConfig));
+      const request = await adapter.buildRequest(await transform(input), { headers: new Headers() });
+      try {
+        const response = await fetch(request.url, { method: "POST", headers: request.headers, body: request.body, proxy: "" });
+        const result = await response.json() as any;
+        expect(JSON.stringify(result.observed)).toContain("Headroom request overview v1");
+        expect(JSON.stringify(result.observed)).not.toContain(original);
+        expect(result.observed.model).toBe("chosen");
+      } finally { request.releaseBodyObservation?.(); }
+    }
+    expect(sends).toBe(2); expect(transforms).toBe(1); expect(input).toEqual(before);
+  } finally { await provider.stop(true); }
+});
diff --git a/tests/responses/token-saver.test.ts b/tests/responses/token-saver.test.ts
new file mode 100644
index 0000000..15c09fa
--- /dev/null
+++ b/tests/responses/token-saver.test.ts
@@ -0,0 +1,124 @@
+import { test, expect } from "bun:test";
+import { createTokenSaverTransform } from "../../src/integrations/token-saver";
+import type { OcxParsedRequest } from "../../src/types";
+import { configSchema } from "../../src/config/schema/config-schema";
+
+const text = "worker output line with details\n".repeat(100);
+const config = { enabled: true, endpoint: "http://127.0.0.1:8789", tokenFile: "unused", protocol: 1 as const };
+function parsed(): OcxParsedRequest {
+  return { modelId: "chosen", stream: true, options: { reasoningEffort: "high" },
+    context: { systemPrompt: ["system"], messages: [
+      { role: "user", content: text, timestamp: 1 },
+      { role: "toolResult", toolCallId: "call1", toolName: "exec", content: text, isError: false, timestamp: 2 },
+    ] }, _rawBody: { model: "chosen", reasoning: { effort: "high" }, input: [
+      { type: "function_call", call_id: "call1", name: "exec", arguments: "{}" },
+      { type: "function_call_output", call_id: "call1", output: text },
+    ] } };
+}
+function reply(body: any) {
+  return { protocol: 1, request_id: body.request_id, outcome: "compressed", replacements: body.entries.map((e: any) => ({
+    id: e.id, original_sha256: e.original_sha256,
+    replacement: `[Headroom request overview v1; exact original: headroom_retrieve(content_hash="${e.original_sha256.slice(0, 12)}")]\nworker summary`,
+    retrieval_reference: e.original_sha256.slice(0, 12),
+  })) };
+}
+function setup(change = (r: any) => r) {
+  const sent: any[] = [];
+  const transform = createTokenSaverTransform(config, "scope", new AbortController().signal, {
+    readToken: async () => "a".repeat(64),
+    localFetch: async (_url: any, init: any) => {
+      const body = JSON.parse(init.body); sent.push(body);
+      return Response.json(change(reply(body)));
+    },
+  });
+  return { transform, sent };
+}
+test("only outbound tool text changes; raw history, roles, pairing and settings survive", async () => {
+  const p = parsed(), before = structuredClone(p), { transform, sent } = setup();
+  const result = await transform(p);
+  expect(p).toEqual(before);
+  expect(result).not.toBe(p);
+  expect(result.context.messages[0]).toBe(p.context.messages[0]);
+  expect(result.context.messages[1]!.content).toContain("worker summary");
+  expect((result._rawBody as any).input[1].output).toBe(result.context.messages[1]!.content);
+  expect(result.options).toBe(p.options);
+  expect(sent[0].entries).toHaveLength(1);
+  expect(JSON.stringify(sent[0])).not.toContain("chosen");
+});
+test("retry reuses a decision and applies it to the latest untouched fields", async () => {
+  const { transform, sent } = setup(); const p = parsed();
+  await transform(p); p.modelId = "existing-provider-recovery";
+  const again = await transform(p);
+  expect(sent).toHaveLength(1); expect(again.modelId).toBe(p.modelId);
+});
+test.each(["id", "original_sha256", "retrieval_reference"])("invalid %s rejects the whole reply", async key => {
+  const { transform } = setup(r => { r.replacements[0][key] = "invalid"; return r; });
+  const p = parsed(); expect(await transform(p)).toBe(p);
+});
+test("duplicate replacements, errors and non-shrinking output bypass", async () => {
+  for (const change of [
+    (r: any) => ({ ...r, replacements: [...r.replacements, ...r.replacements] }),
+    (r: any) => ({ ...r, request_id: "wrong" }),
+    (r: any) => { r.replacements[0].replacement = text; return r; },
+  ]) { const { transform } = setup(change), p = parsed(); expect(await transform(p)).toBe(p); }
+});
+test("multimodal, encrypted and compaction inputs bypass without sending", async () => {
+  for (const patch of [{ _compactionRequest: true }, { _portableCompaction: true }]) {
+    const { transform, sent } = setup(), p = { ...parsed(), ...patch };
+    expect(await transform(p)).toBe(p); expect(sent).toHaveLength(0);
+  }
+  const p = parsed(); (p.context.messages[1] as any).containsEncryptedContent = true;
+  const { transform, sent } = setup(); expect(await transform(p)).toBe(p); expect(sent).toHaveLength(0);
+});
+test("disabled and invalid endpoint do no I/O", async () => {
+  for (const cfg of [{ ...config, enabled: false }, { ...config, endpoint: "https://example.com" }]) {
+    const p = parsed(); const transform = createTokenSaverTransform(cfg, "scope", new AbortController().signal, {
+      readToken: async () => { throw new Error("must not read"); },
+      localFetch: async () => { throw new Error("must not send"); },
+    }); expect(await transform(p)).toBe(p);
+  }
+});
+
+test("schema leaves the extension off by default and rejects foreign destinations", () => {
+  expect(configSchema.shape.tokenSaver.parse(undefined)).toBeUndefined();
+  expect(configSchema.shape.tokenSaver.safeParse({ ...config, endpoint: "https://example.com" }).success).toBe(false);
+});
+
+test("abort and local failures preserve the original and are stable for retries", async () => {
+  const controller = new AbortController(); let calls = 0;
+  const transform = createTokenSaverTransform(config, "scope", controller.signal, {
+    readToken: async () => "a".repeat(64),
+    localFetch: async () => { calls++; throw new Error("local failure"); },
+  });
+  const p = parsed();
+  expect(await transform(p)).toBe(p); expect(await transform(p)).toBe(p);
+  expect(calls).toBe(1); controller.abort();
+  expect(await transform(p)).toBe(p); expect(calls).toBe(1);
+});
+
+test("wire disagreement and multipart outputs are not flattened", async () => {
+  const p = parsed(); (p._rawBody as any).input[1].output = [{ type: "input_text", text }];
+  const { transform, sent } = setup(); expect(await transform(p)).toBe(p); expect(sent).toHaveLength(0);
+});
+
+test("a long-running request cannot reuse an expired retrieval reference", async () => {
+  let now = 0, calls = 0;
+  const transform = createTokenSaverTransform(config, "scope", new AbortController().signal, {
+    now: () => now, readToken: async () => "a".repeat(64),
+    localFetch: async (_url, init) => { calls++; return Response.json(reply(JSON.parse(String(init.body)))); },
+  });
+  const p = parsed(); expect(await transform(p)).not.toBe(p);
+  now = 25 * 60_000;
+  expect(await transform(p)).toBe(p); expect(calls).toBe(1);
+});
+
+test("the deadline also bounds token-file I/O before HTTP starts", async () => {
+  const p = parsed();
+  const transform = createTokenSaverTransform(config, "scope", new AbortController().signal, {
+    readToken: () => new Promise<string>(() => {}),
+    localFetch: async () => { throw new Error("must not send"); },
+  });
+  const started = Date.now();
+  expect(await transform(p)).toBe(p);
+  expect(Date.now() - started).toBeLessThan(1500);
+});
